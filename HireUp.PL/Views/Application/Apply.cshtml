            <!-- ===== FORM ACTIONS ===== -->
            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-paper-plane"></i> Submit Application
                </button>
                @* <button type="button" class="btn-cancel">
