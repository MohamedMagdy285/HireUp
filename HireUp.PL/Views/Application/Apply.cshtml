@section Styles {
    <link href="~/css/Application/Apply.css" rel="stylesheet">
}


<!-- ===== HEADER SECTION ===== -->
<section class="header-section">
    <div class="container-lg">
        <div class="header-content">
            <h1 class="header-title" style="color:white" ><i class="fas fa-file-alt"></i> Apply for Job</h1>
            <p class="header-subtitle" style="color:white">Submit your application to apply for this position</p>

            <!-- Job Preview -->
            <div class="job-preview">
                @* <div class="job-preview-title">Senior Full Stack Developer</div> *@
                <div  class="job-preview-title" >@Model.Job.Title</div>
                <div class="job-preview-info">
                    @* <span><i class="fas fa-building"></i> TechCorp Solutions</span> *@
                    <span><i class="fas fa-building"></i> @(@Model.Company.Name ?? "UnKnown")</span>
                    @* <span><i class="fas fa-map-marker-alt"></i> Cairo, Egypt</span> *@
                    <span><i class="fas fa-map-marker-alt"></i> @Model.Company.Country - @Model.Company.Location</span>
                    @* <span><i class="fas fa-dollar-sign"></i> $60k - $80k</span> *@
                    <span><i class="fas fa-dollar-sign"></i>@($"{Model.Job.SalaryMin / 1000}K - {Model.Job.SalaryMax / 1000}K")</span>
                </div>
            </div>
        </div>
    </div>
</section>

