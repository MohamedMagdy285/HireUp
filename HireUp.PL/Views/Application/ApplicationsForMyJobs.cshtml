@model List<ApplicationViewModel>

@{
    Layout = "_Layout";
}

@section Styles {
	<link href="~/css/Application/ApplicationsForMyJobs.css" rel="stylesheet">
}
<!-- ===== HEADER SECTION ===== -->
<section class="header-section">
	<div class="container-lg">
		<div class="header-content">
			<h1 class="header-title" style="color:white"><i class="fas fa-inbox"></i> Job Applications</h1>
			<p class="header-subtitle" style="color:white">Manage and review all applications from job seekers</p>
		</div>
		<div class="search-section" style="margin-top: 30px;">
			<form method="GET" class="search-box">
				<i class="fas fa-search search-icon"></i>
				<input type="text"
					   class="search-input"
					   name="search"
					   placeholder="Search by applicant name or job position...">
				<button type="submit" class="search-btn">
					<i class="fas fa-search"></i> Search
				</button>
			</form>
		</div>
	</div>
</section>

<!-- ===== MAIN CONTENT ===== -->
<main class="container-lg mb-5">
	@if (Model.Count() > 0)
	{
		<!-- ===== TABLE SECTION ===== -->
		<div class="table-container">
			<table class="table">
				<thead>
					<tr>
						<th>Applicant</th>
						<th>Job Position</th>
						<th>Applied On</th>
						<th>Status</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					<!-- Application 1 -->
					@foreach (var app in Model)
					{

						<tr>
							<td>
								<div class="applicant-info">
									<div class="applicant-avatar">A</div>
									<div class="applicant-details">
										<h6>@app.JobSeeker.FirstName @app.JobSeeker.LastName</h6>
										<p>@app.JobSeeker.Email</p>
									</div>
								</div>
							</td>
							<td>
								<strong>@app.Job.Title</strong><br>
								<small style="color: #7A8A99;">@(app.Job.Company?.Name ?? "UNKNOWN")</small>
							</td>
							<td>
								<small>@app.AppliedAt</small>
							</td>
							@if(app.Status=="Pending")
							{
								<td>
									<span class="status-badge status-pending">@app.Status</span>
								</td>
							}
							else if (app.Status == "Approved")
							{
								<td>
									<span class="status-badge status-approved">@app.Status</span>
								</td>
							}else
							{
								
							<td>
								<span class="status-badge status-rejected">@app.Status</span>
							</td>
							}
							<td>
								<div class="action-buttons">
									@* <form method="get" asp-controller="JobSeeker" asp-action="Profile" asp-route-id="@app.JobSeekerId" style="display: inline;">
										
										<button type="submit" name="viewProfile" value="1" class="btn-small btn-view">
											<i class="fas fa-user"></i> View Profile
										</button>
									</form>*@
									<form method="get"
										  asp-controller="JobSeeker"
										  asp-action="Profile"
										  asp-route-id="@app.JobSeekerId">
										  
										<button type="submit" name="viewProfile" value="1" class="btn-small btn-view">
											<i class="fas fa-user"></i> View Profile
										</button>
									</form>

									
								<div class="profile-action-buttons">
									<!-- Approve Button -->
									
									<!-- Reject Button -->
									
									<form asp-action="Approve" asp-controller="Application" asp-route-id="@app.Id" method="POST" style="display: inline;">
										<button  class="btn-small btn-approve">
											<i class="fas fa-check"></i> Approve
										</button>
									</form>
									<form asp-action="Reject" asp-controller="Application" asp-route-id="@app.Id" method="POST" style="display: inline;">
										<button  class="btn-small btn-reject">
											<i class="fas fa-times"></i> Reject
										</button>
									</form>
								</div>


								</div>
							</td>
						</tr>
					}					
				
				</tbody>
			</table>
		</div>
	}
    else
    {
            <!-- No Results -->
            <div class="no-results" style="margin:auto">
                <i class="fas fa-inbox"></i> <h3>No applications found</h3>
                <p>Try adjusting your filters</p>
            </div>
        
    }

</main>
