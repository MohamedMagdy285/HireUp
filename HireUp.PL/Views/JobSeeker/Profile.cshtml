@model JobSeekerProfileViewModel

@{
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/JobSeeker/Profile.css" asp-append-version="true" />
}

<div class="profile-container">
    <!-- Profile Header with Background -->
    <div class="profile-header-bg"></div>

    <!-- Profile Content -->
    <div class="profile-content">
        <!-- Profile Header -->
        <div class="profile-header">
            <div class="profile-image-default">
    @* @if(Model.ProfileImageUrl is not null)
    {
        <img src="@Url.Content("~/imageProfiles/" + Model.ProfileImageUrlForDisplay)" />

    }
    else
    {
        <i class="fas fa-user"></i>
    } *@
    @if (!string.IsNullOrEmpty(Model.ProfileImageUrlForDisplay))
{
    <img src="~/imageProfiles/@Model.ProfileImageUrlForDisplay" />
}
else
{
    <i class="fas fa-user"></i>
}

</div>

            @* <h2 class="profile-name">John Doe</h2> *@
            <h2 class="profile-name">@Model.FullName</h2>
            @* <p class="profile-email">john.doe@example.com</p> *@
            <p class="profile-email">@Model.Email</p>
            <span class="profile-badge"><i class="fas fa-check-circle"></i> Profile Complete</span>
        </div>

        <!-- Personal Information -->
        <div class="profile-section">
            <h3 class="section-title">
                <i class="fas fa-id-card"></i>
                Personal Information
            </h3>
            <div class="info-item">
                <span class="info-label">National ID:</span>
                @* <span class="info-value">12345678901234</span> *@
                <span class="info-value">@Model.NationalNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Phone:</span>
                @* <span class="info-value">+20 123 456 7890</span> *@
                <span class="info-value">@((Model?.PhoneNumber ?? "No Phone Number yet"))</span>

            </div>
            <div class="info-item">
                <span class="info-label">Email:</span>
                <span class="info-value">@Model.Email</span>
            </div>
        </div>

        <!-- Professional Information -->
        <div class="profile-section">
            <h3 class="section-title">
                <i class="fas fa-briefcase"></i>
                Professional Information
            </h3>
            <div class="info-item">
                <span class="info-label">Experience:</span>

                <span class="info-value">
                    @((Model.ExperinceYears?.ToString() ?? "No Exp yet"))
                </span>

            </div>
            <div class="info-item">
                <span class="info-label">Education:</span>
                <span class="info-value">@((Model?.Education ?? "No Education yet" ))</span>
            </div>
            <div class="info-item">
                <span class="info-label">CV:</span>
                @* @if (Model.CVPath is not null)
                {
                    
                <span class="info-value">
                    <a download href="~/CVs/@Model.CVPathForDisplay">
                        <i class="fas fa-file-pdf"></i> Download
                    </a>
                </span>
                }
                else{
                    <span class="info-value">No CV Uploaded</span>
                } *@
                @if (!string.IsNullOrEmpty(Model.CVPathForDisplay))
{
    <a download href="~/CVs/@Model.CVPathForDisplay">
        <i class="fas fa-file-pdf"></i> Download
    </a>
}
else
{
    <span class="info-value">No CV Uploaded</span>
}

            </div>
        </div>

        <!-- Skills -->
@*         <div class="profile-section">
            <h3 class="section-title">
                <i class="fas fa-star"></i>
                Skills
            </h3>
            <div>
               <div class="skills-list">
    @if (Model.Skills != null && Model.Skills.Any())
    {
        foreach (var skill in Model.Skills)
        {
            <span class="job-tag">@skill</span>
        }
    }
    else
    {
        <span class="job-tag">No Skills yet</span>
    }
</div>


            </div>
        </div> *@

        <!-- Bio -->
        <div class="profile-section">
            <h3 class="section-title">
                <i class="fas fa-align-left"></i>
                Bio
            </h3>
            <div class="bio-text">@(Model.Bio ?? "No Bio yet" )</div>
        </div>

        <!-- Action Buttons -->
        @if (User.IsInRole("JobSeeker"))
        {
            <partial name="_ButtonsProfilePartialView" model="Model" />
        }
        else if(User.IsInRole("Company"))
        {
            @* <partial name="_ButtonProfileApprove" model="Model" /> *@
        }
        else 
        {
            
        <div class="profile-action-buttons">
            @* <a asp-controller="JobSeeker" asp-action="UpdateProfile" asp-route-jobseekerid="@Model.Id"  class="btn-profile-primary">
                <i class="fas fa-edit"></i> Edit Profile
            </a> *@
            <a asp-controller="Application" asp-action="MyApplications" class="btn-profile-secondary">
                <i class="fas fa-list"></i> My Applications
            </a>
        </div>
        }
        
    </div>
</div>

@* @section Scripts {
    <script>
        function downloadCV(event) {
            event.preventDefault();
            alert('CV download feature coming soon!');
        }
    </script>
} *@