@model LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HireUp - Sign In</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/Auth/Login.css" rel="stylesheet">
</head>
<body>
    <div class="signin-container">
        <!-- LEFT SECTION - HERO -->
        <div class="left-section">
            <div class="hero-content">
                <h1>Find Your Dream Job Today</h1>
                <p>Join thousands of professionals who found their perfect career opportunity through HireUp.</p>
                <ul class="hero-features">
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Access to 10,000+ job listings</span>
                    </li>
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Connect with top employers</span>
                    </li>
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Get personalized job recommendations</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- RIGHT SECTION - FORM -->
        <div class="right-section">
            <div class="form-wrapper">
                <!-- Header -->
                <div class="form-header">
                    <h2>Welcome Back</h2>
                    <p>Sign in to continue to your account</p>
                </div>

                <!-- Login Form -->
                <form id="loginForm" asp-Controller="Account" asp-action="Login" method="post" novalidate>
                    <!-- Email Address -->
                    <div class="form-group">
                        <label asp-for="Email">Email Address *</label>
                        <div class="input-icon">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="you@example.com"
                                   required />
                        </div>
                        <span class="error-message" id="Email-error"></span>
                        @* <span class="error-message" asp-validation-for="Email"></span> *@
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        <label asp-for="Password">Password *</label>
                        <div class="input-icon">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   required />
                            @* <button type="button" class="password-toggle" onclick="togglePassword('password')">
                                <i class="fas fa-eye"></i>
                            </button> *@
                        </div>
                        <span class="error-message" id="Password-error"></span>
                        @* <span class="error-message" asp-validation-for="Password"></span> *@
                    </div>

                    <!-- Remember Me & Forgot Password Row -->
                    <div class="form-row">
                        <div class="checkbox-group">
                            <input asp-for="RememberMe">
                            <label asp-for="RememberMe">Remember me for 30 days</label>
                        </div>
                        <a href="#forgot-password" class="forgot-password">Forgot password?</a>
                    </div>

                    <!-- Sign In Button -->
                    <button type="submit" class="btn-signin">Sign in</button>

                    <!-- Divider -->
                    <div class="divider">
                        <span>OR CONTINUE WITH</span>
                    </div>

                    <!-- Social Login Buttons -->
                    <div class="social-buttons">
                        <button type="button" class="btn-social" onclick="socialLogin('google')">
                            <i class="fab fa-google"></i>
                            Google
                        </button>
                        <button type="button" class="btn-social" onclick="socialLogin('facebook')">
                            <i class="fab fa-facebook"></i>
                            Facebook
                        </button>
                    </div>

                    <!-- Sign Up Link -->
                    <p class="signup-link">
                        Don't have an account? <a asp-controller="Account" asp-action="SelectionRole">Sign up</a>
                    </p>
                </form>
            </div>  
        </div>
    </div>
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script> *@
    <script src="~/js/Auth/Login.js"></script>
</body>
</html>

