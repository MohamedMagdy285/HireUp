@model RegisterCompanyViewModel

@inject ICategoryRepository _categoryRepository;

@{
    Layout = null;
    var Categories = _categoryRepository.GetAll();
    SelectList CategoryList = new SelectList(Categories, "Id", "Name");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HireUp - Register as Company</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/Auth/RegisterCompany.css" rel="stylesheet">
</head>
<body>
    <div class="signup-container">
        <!-- LEFT SECTION - HERO -->
        <div class="left-section">
            <div class="hero-content">
                <h1>Grow Your Business</h1>
                <p>Join thousands of companies that successfully hired top talent through HireUp.</p>
                <ul class="hero-features">
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Access to thousands of qualified candidates</span>
                    </li>
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Streamlined hiring process</span>
                    </li>
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Analytics and insights dashboard</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- RIGHT SECTION - FORM -->
        <div class="right-section">
            <div class="form-wrapper">
                <!-- Header -->
                <div class="form-header">
                    <h2>Create Your Account</h2>
                    <p>Register HireUp and start recruiting top talent</p>
                </div>

                <!-- Registration Form -->
                <form id="companyForm" asp-controller="Account" asp-action="RegisterCompany" method="post" novalidate>
                    <!-- Company Name & Industry Row -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Name">Company Name *</label>
                            <div class="input-icon">
                                <i class="fas fa-building"></i>
                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Your Company Name"
                                       maxlength="50"
                                       required />
                            </div>
                            <span class="error-message" id="Name-error"></span>
                            @* <span class="error-message" asp-validation-for="Name"></span> *@
                        </div>
                        <div class="form-group">
                            <label asp-for="Industry">Industry *</label>
                            <div class="input-icon">
                                <i class="fas fa-industry"></i>
                                <select class="form-control" asp-for="CategoryId" asp-items="CategoryList" required>
                                    <option value="7" disabled selected>Select Category</option>
                                </select>
                            </div>
                            <span class="error-message" id="Industry-error"></span>
                            @* <span class="error-message" asp-validation-for="Industry"></span> *@
                        </div>
                    </div>

                    <!-- Email & Country Row -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Email">Email Address *</label>
                            <div class="input-icon">
                                <i class="fas fa-envelope"></i>
                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="company@example.com"
                                       required />
                            </div>
                            <span class="error-message" id="Email-error"></span>
                            @* <span class="error-message" asp-validation-for="Email"></span> *@
                        </div>
                        <div class="form-group">
                            <label asp-for="Country">Country *</label>
                            <div class="input-icon">
                                <i class="fas fa-globe"></i>
                                <select class="form-control" asp-for="Country" required>
                                    <option value="">Select a country</option>
                                    <option value="United Arab Emirates">United Arab Emirates</option>
                                    <option value="Saudi Arabia">Saudi Arabia</option>
                                    <option value="Egypt">Egypt</option>
                                    <option value="Kuwait">Kuwait</option>
                                    <option value="Qatar">Qatar</option>
                                    <option value="Bahrain">Bahrain</option>
                                    <option value="Oman">Oman</option>
                                    <option value="Jordan">Jordan</option>
                                    <option value="Lebanon">Lebanon</option>
                                    <option value="United States">United States</option>
                                    <option value="United Kingdom">United Kingdom</option>
                                    <option value="Canada">Canada</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <span class="error-message" id="Country-error"></span>
                            @* <span class="error-message" asp-validation-for="Country"></span> *@
                        </div>
                    </div>

                    <!-- City/Location Row (Full Width) -->
                    <div class="form-group">
                        <label asp-for="Location">City/Location *</label>
                        <div class="input-icon">
                            <i class="fas fa-map-marker-alt"></i>
                            <input asp-for="Location"
                                   class="form-control"
                                   placeholder="Cairo"
                                   required />
                        </div>
                        <span class="error-message" id="Location-error"></span>
                        @* <span class="error-message" asp-validation-for="Location"></span> *@
                    </div>

                    <!-- Password & Confirm Password Row -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Password">Password *</label>
                            <div class="input-icon">
                                <i class="fas fa-lock"></i>
                                <input asp-for="Password"
                                       class="form-control"
                                       placeholder="Create a strong password"
                                       required />
                                @* <button type="button" class="password-toggle" onclick="togglePassword('password')">
                                    <i class="fas fa-eye"></i>
                                </button> *@
                            </div>
                            <span class="error-message" id="Password-error"></span>
                            @* <span class="error-message" asp-validation-for="Password"></span> *@
                            <div class="helper-text">At least 8 characters</div>
                        </div>
                        <div class="form-group">
                            <label asp-for="ConfirmPassword">Confirm Password *</label>
                            <div class="input-icon">
                                <i class="fas fa-lock"></i>
                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       placeholder="Re-enter your password"
                                       required />
                                @* <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword')">
                                    <i class="fas fa-eye"></i>
                                </button> *@
                            </div>
                            <span class="error-message" id="ConfirmPassword-error"></span>
                            @* <span class="error-message" asp-validation-for="ConfirmPassword"></span> *@
                        </div>
                    </div>

                    <!-- Terms & Conditions -->
                    <div class="checkbox-group">
                        <input asp-for="Terms" required>
                        <label asp-for="Terms">
                            I agree to the <a href="#">Terms & Conditions</a> and <a href="#">Privacy Policy</a>
                        </label>
                    </div>
                    <span class="error-message" id="Terms-error"></span>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-register">Create Company Account</button>

                    <!-- Divider -->
                    <div class="divider">
                        <span>OR CONTINUE WITH</span>
                    </div>

                    <!-- Social Buttons -->
                    <div class="social-buttons">
                        <button type="button" class="btn-social">
                            <i class="fab fa-google"></i>
                            Google
                        </button>
                        <button type="button" class="btn-social">
                            <i class="fab fa-facebook"></i>
                            Facebook
                        </button>
                    </div>

                    <!-- Sign In Link -->
                    <p class="signin-link">
                        Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script> *@
    <script src="~/js/Auth/RegisterCompany.js"></script>
</body>
</html>



