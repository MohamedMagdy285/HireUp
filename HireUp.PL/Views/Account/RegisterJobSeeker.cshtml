@model RegisterJobSeekerViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HireUp - Register as Job Seeker</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/Auth/RegisterJobSeeker.css" rel="stylesheet">
</head>
<body>
    <div class="signup-container">
        <!-- LEFT SECTION - HERO -->
        <div class="left-section">
            <div class="hero-content">
                <h1>Start Your Career Journey</h1>
                <p>Join thousands of professionals who found their perfect job opportunity through HireUp.</p>
                <ul class="hero-features">
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Access to 10,000+ job listings</span>
                    </li>
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Connect with top employers</span>
                    </li>
                    <li>
                        <i class="fas fa-check"></i>
                        <span>Get personalized job recommendations</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- RIGHT SECTION - FORM -->
        <div class="right-section">
            <div class="form-wrapper">
                <!-- Header -->
                <div class="form-header">
                    <h2>Create Your Account</h2>
                    <p>Join HireUp and start your job search today</p>
                </div>

                <!-- Registration Form -->
                <form id="jobSeekerForm" asp-controller="Account" asp-action="RegisterJobSeeker" method="post" novalidate>
                    <!-- National ID & Email Row -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="NationalNumber">National ID *</label>
                            <div class="input-icon">
                                <i class="fas fa-id-card"></i>
                                <input asp-for="NationalNumber"
                                       class="form-control"
                                       placeholder="14-digit national ID"
                                       maxlength="14"
                                       required />
                            </div>
                            <span class="error-message" id="NationalNumber-error"></span>
                            @* <span class="error-message" asp-validation-for="NationalNumber"></span> *@
                            <div class="helper-text">Must be exactly 14 digits</div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Email">Email Address *</label>
                            <div class="input-icon">
                                <i class="fas fa-envelope"></i>
                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="your@example.com"
                                       required />
                            </div>
                            <span class="error-message" id="Email-error"></span>
                            @* <span class="error-message" asp-validation-for="Email"></span> *@
                        </div>
                    </div>

                    <!-- First Name & Last Name Row -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="FirstName">First Name *</label>
                            <div class="input-icon">
                                <i class="fas fa-user"></i>
                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Mo"
                                       maxlength="50"
                                       required />
                            </div>
                            <span class="error-message" id="FirstName-error"></span>
                            @* <span class="error-message" asp-validation-for="FirstName"></span> *@
                        </div>
                        <div class="form-group">
                            <label asp-for="LastName">Last Name *</label>
                            <div class="input-icon">
                                <i class="fas fa-user"></i>
                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Salah"
                                       maxlength="50"
                                       required />
                            </div>
                            <span class="error-message" id="LastName-error"></span>
                            @* <span class="error-message" asp-validation-for="LastName"></span> *@
                        </div>
                    </div>

                    <!-- Country & Location Row -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Country">Country *</label>
                            <div class="input-icon">
                                <i class="fas fa-globe"></i>
                                <select class="form-control" asp-for="Country" required>
                                    <option value="">Select your country</option>
                                    <option value="Egypt">Egypt</option>
                                    <option value="United Arab Emirates">United Arab Emirates</option>
                                    <option value="Saudi Arabia">Saudi Arabia</option>
                                    <option value="Kuwait">Kuwait</option>
                                    <option value="Qatar">Qatar</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <span class="error-message" id="Country-error"></span>
                            @* <span class="error-message" asp-validation-for="Country"></span> *@
                        </div>
                        <div class="form-group">
                            <label asp-for="Location">City/Location *</label>
                            <div class="input-icon">
                                <i class="fas fa-map-marker-alt"></i>
                                <input asp-for="Location"
                                       class="form-control"
                                       placeholder="Cairo"
                                       required />
                            </div>
                            <span class="error-message" id="Location-error"></span>
                            @* <span class="error-message" asp-validation-for="Location"></span> *@
                        </div>
                    </div>

                    <!-- Password & Confirm Password Row -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Password">Password *</label>
                            <div class="input-icon">
                                <i class="fas fa-lock"></i>
                                <input asp-for="Password"
                                       class="form-control"
                                       placeholder="Create a strong password"
                                       required />
                                @* <button type="button" class="password-toggle" onclick="togglePassword('password')">
                                    <i class="fas fa-eye"></i>
                                </button> *@
                            </div>
                            <span class="error-message" id="Password-error"></span>
                            @* <span class="error-message" asp-validation-for="Password"></span> *@
                            <div class="helper-text">At least 8 characters</div>
                        </div>
                        <div class="form-group">
                            <label asp-for="ConfirmPassword">Confirm Password *</label>
                            <div class="input-icon">
                                <i class="fas fa-lock"></i>
                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       placeholder="Re-enter your password"
                                       required />
                                @* <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword')">
                                    <i class="fas fa-eye"></i>
                                </button> *@
                            </div>
                            <span class="error-message" id="ConfirmPassword-error"></span>
                            @* <span class="error-message" asp-validation-for="ConfirmPassword"></span> *@
                        </div>
                    </div>

                    <!-- Terms & Conditions -->
                    <div class="checkbox-group">
                        <input asp-for="Terms" required>
                        <label asp-for="Terms">
                            I agree to the <a href="#">Terms & Conditions</a> and <a href="#">Privacy Policy</a>
                        </label>
                    </div>
                    <span class="error-message" id="terms-error"></span>  
                    @* <span class="error-message" asp-validation-for="Terms"></span> *@
                    <!-- Submit Button -->
                    <button type="submit" class="btn-register">Create Account</button>

                    <!-- Divider -->
                    <div class="divider">
                        <span>OR CONTINUE WITH</span>
                    </div>

                    <!-- Social Buttons -->
                    <div class="social-buttons">
                        <button type="button" class="btn-social">
                            <i class="fab fa-google"></i>
                            Google
                        </button>
                        <button type="button" class="btn-social">
                            <i class="fab fa-facebook"></i>
                            Facebook
                        </button>
                    </div>

                    <!-- Sign In Link -->
                    <p class="signin-link">
                        Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script> *@
    <script src="~/js/Auth/RegisterJobSeeker.js"></script>
</body>
</html>


