@model List<JobViewModel>
@inject ICategoryRepository _categoryRepository;
@inject IJobRepository _jobRepository;
@{
    Layout = "_Layout";
    var Jobs = _jobRepository.GetAll();
    var Categories = _categoryRepository.GetAll();
    SelectList CategoryList = new SelectList(Categories, "Id", "Name");
}


<!-- Custom CSS -->
@section Styles {
    <link href="~/css/Job/JobIndex.css" rel="stylesheet">
}

    <!-- ===== SEARCH BAR SECTION ===== -->
    <form asp-controller="Job" asp-action="Index" method="get">
    <section class="search-section">
        <div class="container-lg">
            <div class="search-container">
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text"
                           class="search-input"
                           id="searchInput"
                           name="SearchValue"
                           placeholder="Search jobs by title, company, location...">
                    <button type="submit" class="search-btn" id="searchBtn">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
                <div class="search-error" id="searchError"></div>
            </div>
        </div>
    </section>
</form>
    <!-- ===== MAIN CONTENT WITH SIDEBAR ===== -->
    <main class="container-lg mb-lg-5">
        <div class="content-wrapper">
            <!-- ===== CATEGORIES SIDEBAR ===== -->
        <aside class="categories-sidebar">
            <h3 class="sidebar-title"><i class="fas fa-filter"></i> Categories</h3>
            <div class="categories-container">
                <form method="get" asp-controller="Job" asp-action="Index">
                    <button type="submit" class="category-pill @(ViewBag.CategoryId == null ? "active" : "")">
                        <span class="category-name">All</span>
                        <span class="count">@Jobs.Count()</span>
                    </button>
                </form>
                @foreach (var cat in Categories)
                {
                    <form method="get" asp-controller="Job" asp-action="Index">
                        <input type="hidden" name="categoryId" value="@cat.Id" />
                        <button type="submit" class="category-pill @(ViewBag.CategoryId == cat.Id ? "active" : "")">
                            <span class="category-name">@cat.Name</span>
                            @* <span class="count">@(cat.Jobs?.Count() > 0 ? cat.Jobs.Count() : 0)</span> *@
                            <span class="count">@cat.Jobs?.Count()</span>
                        </button>
                    </form>
                }
            </div>
        </aside>
        <!-- ===== JOBS LISTING ===== -->
            <section class="jobs-list-section">      
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3>
                        <i class="fas fa-briefcase"></i>
                        <span id="jobsHeading">
                        @if (ViewBag.CategoryId is not null)
                        {
                            @($"{Categories.FirstOrDefault(c => c.Id == ViewBag.CategoryId)?.Name} Jobs ({Model.Count()})")
                        }
                        else if (ViewBag.CategoryId is null && ViewBag.Flage is null)
                        {
                            @($"All Jobs ({Jobs.Count()})")
                        }
                        else
                        {
                            @($"Searched Jobs ({ViewBag.Flage})")
                        }
                    </span>
                    </h3>         
                </div>

                <!-- If jobs exist -->
                @if (Model.Count() > 0)
                {
                    <partial name="PartialViews/_JobList" model="Model" />
                }
                else
                {
                    <!-- No results section -->
                    <div id="no-results" class="text-center" style="margin-top: 180px; margin-left: 250px;">
                        <i class="fas fa-search" style="font-size: 50px; color: #c8d1e0;"></i>
                        <h3 class="mt-3">No jobs found</h3>
                        <p>Try selecting a different category</p>
                    </div>
                }
   
               
            </section>
   
        </div>
    </main>
