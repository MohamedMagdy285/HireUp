@model List<JobViewModel>
@{
    Layout = "_Layout";
}
@section Styles
{
    <link href="~/css/Job/MyJobs.css" rel="stylesheet">
}
<!-- ===== HEADER SECTION ===== -->
<section class="header-section">
	<div class="container-lg">
		<div class="header-content">
			<h1 class="header-title" style="color:white"><i class="fas fa-inbox"></i> My Published Jobs</h1>
			<p class="header-subtitle" style="color:white">Browse All Published Jobs</p>
		</div>
		<div class="search-section" style="margin-top: 30px;">
			<form method="GET" class="search-box">
				<i class="fas fa-search search-icon"></i>
				<input type="text"
					   class="search-input"
					   name="search"
					   placeholder="Search by Job Title">
				<button type="submit" class="search-btn">
					<i class="fas fa-search"></i> Search
				</button>
			</form>
		</div>
	</div>
</section>

<!-- ===== MAIN CONTENT ===== -->
<main class="container-lg mb-5">
	@if (Model.Count() > 0)
	{
		<!-- ===== TABLE SECTION ===== -->
		<div class="table-container">
			<table class="table" style="text-align: center;">
				<thead>
					<tr >
						@* <th>Applicant</th> *@
						<th>Job Title</th>
						<th>Publish Date</th>
						@* <th>Status</th> *@
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					<!-- Application 1 -->
					@foreach (var app in Model)
					{

						<tr>
							@* <td>
								<div class="applicant-info">
									<div class="applicant-avatar">A</div>
									<div class="applicant-details">
										<h6>@app.JobSeeker.FirstName @app.JobSeeker.FirstName</h6>
										<p>@app.JobSeeker.Email</p>
									</div>
								</div>
							</td> *@
							<td>
								<strong>@app.Title</strong><br>
								@* <small style="color: #7A8A99;">@(app.Job.Company?.Name ?? "UNKNOWN")</small> *@
							</td>
							<td>
								<small>@app.CreatedAt</small>
							</td>
							@* @if (app.Status == "Pending")
							{
								<td>
									<span class="status-badge status-pending">@app.Status</span>
								</td>
							}
							else if (app.Status == "Approved")
							{
								<td>
									<span class="status-badge status-approved">@app.Status</span>
								</td>
							}
							else
							{

								<td>
									<span class="status-badge status-rejected">@app.Status</span>
								</td>
							} *@
							<td>
								<div class="action-buttons">

									<form method="get"
										  asp-controller="Job"
										  asp-action="Details"
										  asp-route-id="@app.Id">

										<button class="btn-small btn-view">
											<i class="fas fa-user"></i> View Job
										</button>
									</form>
									<form asp-controller="Job" asp-action="Delete" asp-route-id="@app.Id" method="post" style="display: inline;">
										@* <input type="hidden" name="id" value="@app.Id" /> *@

										<button type="submit" class="btn-small btn-delete"
												onclick="return confirm('Delete this Job?');">
											<i class="fas fa-trash"></i> Delete
										</button>
									</form>



								</div>
							</td>
						</tr>
					}

				</tbody>
			</table>
		</div>
	}
	else
	{
		<!-- No Results -->
		<div class="no-results" style="margin:auto">
			<i class="fas fa-inbox"></i> <h3>No applications found</h3>
			<p>Try adjusting your filters</p>
		</div>

	}

</main>
