@model List<CompanyViewModel>

<!-- ===== COMPANIES LIST SECTION ===== -->
<section class="companies-list-section">
    <!-- ===== COMPANIES HEADER ===== -->
    <div class="companies-header">
        <h3 class="companies-title">
            <i class="fas fa-building"></i>
            <span id="companiesHeading">
                @if (Model?.Any() == true)
                {
                    <span>@Model.Count() Companies Found</span>
                }
                else
                {
                    <span>Companies</span>
                }
            </span>
        </h3>
    </div>

    <!-- ===== COMPANIES GRID ===== -->
    <div class="companies-grid" >
        @if (Model?.Any() == true)
        {
            @foreach (var company in Model)
            {
                <div class="company-card">                   
                    <div class="company-card-header" style="text-align:left; padding:10px;">
                        <div class="company-logo-container" style="width:50px; height:50px; margin-left:0;">

                            @if (company.LogoURL is not null)
                            {
                                <img src="@company.LogoURL"
                                     alt="@company.Name"
                                     style="width:100%; height:100%; object-fit:cover; border-radius:12px; border:2px solid #dbe9ff;" />
                            }
                            else
                            {
                                <div style="
                            width:100%;
                            height:100%;
                            background:#E6F0FF;                  /* الأزرق الفاتح */
                            color:#2F80ED;                        /* أزرق غامق */
                            border-radius:12px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            font-size:32px;
                            font-weight:700;
                            border:2px solid #d0e2ff;            /* درجة أفتح */
                        ">
                                    <span>@company.Name.FirstOrDefault()</span>
                                </div>
                            }
                        </div>
                    </div>


                    <!-- Company Info -->
                    <div class="company-card-body">
                        <!-- Company Name -->
                        <h4 class="company-name">@company.Name</h4>

                        <!-- Industry Tag -->
                        @if (!string.IsNullOrEmpty(company.Industry))
                        {
                            <span style="
                    display:inline-block;
                    background:#E8F2FF;      /* أزرق فاتح */
                    color:#2F80ED;            /* أزرق غامق */
                    padding:6px 14px;
                    font-size:12px;
                    font-weight:600;
                    border-radius:20px;
                    letter-spacing:1px;
                    margin-bottom:10px;
                    text-transform:uppercase;
                ">
                                @company.Industry
                            </span>
                        }


                        <!-- Rating (optional - can be added from Job model if needed) -->
                        <div class="company-rating">
                            <span class="rating-stars">
                                <i class="fas fa-star"></i>
                                <span class="rating-value">4.8</span>
                            </span>
                            <span class="rating-count">(89)</span>
                        </div>

                        <!-- Description -->
                        @if (!string.IsNullOrEmpty(company.Description))
                        {
                <p class="company-description">
                    @Html.Raw(company.Description.Length > 80
                                        ? company.Description.Substring(0, 80) + "..."
                                        : company.Description)
                </p>
                                }

                        <!-- Location -->
                        <div class="company-meta">
                            <span class="company-location">
                                <i class="fas fa-map-marker-alt"></i>
                                Location: Cairo, Egypt
                            </span>
                        </div>

                       
                    </div>

                    <!-- Visit Website Button -->
                    <div class="company-card-footer">                     
                            <a asp-action="Profile" asp-controller="Company" asp-route-id="@company.Id" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-visit-website">
                                <i class="fas fa-external-link-alt"></i> Visit Website
                            </a>                        
                    </div>
                </div>
            }
        }
    </div>

    <!-- ===== NO RESULTS ===== -->
    @if (Model?.Any() != true)
    {
        <div id="no-results" class="text-center" style="margin-top: 180px; margin-left: 250px">
            <i class="fas fa-search" style="font-size: 50px; color: #c8d1e0"></i>
            <h3 class ="mt-3">No companies found</h3>
            <p>Try adjusting your search or filters</p>
        </div>
    }
</section>
