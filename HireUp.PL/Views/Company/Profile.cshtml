@model CompanyViewModel
@{
    Layout = "_Layout";
    var loggedInUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Company/CompanyProfile.css" />
    <link rel="stylesheet" href="~/css/JobSeeker/Profile.css" asp-append-version="true" />
}

    <!-- Company Profile Page -->
    <div class="page-wrapper">
        <div class="profile-container">
            <!-- Profile Header with Background -->
            <div class="profile-header-bg"></div>

            <!-- Profile Content -->
            <div class="profile-content">
                <!-- Profile Header -->
                <div class="profile-header">
                    <div class="company-logo">
                        <i class="fas fa-building"></i>
                    </div>
                    <h2 class="profile-name">@Model.Name</h2>
                    <p class="profile-subtitle">@(Model.Industry ?? "NA")</p>
                    <span class="profile-badge"><i class="fas fa-check-circle"></i> Verified Company</span>
                </div>

                <!-- Company Information -->
                <div class="profile-section">
                    <h3 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Company Information
                    </h3>
                    <div class="info-item">
                        <span class="info-label">Industry:</span>
                        <span class="info-value">@Model.Industry</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Website:</span>
                        <span class="info-value">
                            <a href="#" onclick="visitWebsite(event)">
                                <i class="fas fa-globe"></i> Visit Website
                            </a>
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Founded:</span>
                        <span class="info-value">@(Model.CreatedAt)</span>
                    </div>
                </div>

                <!-- Company Description -->
                <div class="profile-section">
                    <h3 class="section-title">
                        <i class="fas fa-align-left"></i>
                        About
                    </h3>
                    <div class="bio-text">
                    @(Model.Description ?? "We are a software development company dedicated to delivering innovative and high-quality solutions. Our team of experienced developers, designers, and engineers works closely with clients to understand their needs and transform ideas into functional and scalable software applications")
                    </div>
                </div>

                <!-- Open Jobs -->
                <div class="profile-section">
                    <h3 class="section-title">
                        <i class="fas fa-briefcase"></i>
                    Open Positions (@Model.Jobs.Count())
                    </h3>
                    <div class="jobs-list">
                    @if(Model.Jobs.Count() > 0)
                    {
                        foreach(var job in Model.Jobs)
                        {
                            
                         <a asp-controller="Job" asp-action="Details" asp-route-id="@job.Id">
                                <div class="job-card">
                                    <div class="job-title">@job.Title</div>
                                    <span class="job-type">@job.Type</span>
                                </div>
                         </a>
                        }
                    }
                    else
                    {
                        
                    <div class="job-card">
                            <div class="job-title text-secondary">No Jobs At This Time !!</div>
                        </div>
                    }
                        
                        @* <div class="job-card">
                            <div class="job-title">Cloud DevOps Engineer</div>
                            <span class="job-type">Full-time</span>
                        </div>
                        <div class="job-card">
                            <div class="job-title">UI/UX Designer</div>
                            <span class="job-type">Full-time</span>
                        </div>
                        <div class="job-card">
                            <div class="job-title">Machine Learning Engineer</div>
                            <span class="job-type">Full-time</span>
                        </div>
                        <div class="job-card">
                            <div class="job-title">QA Automation Specialist</div>
                            <span class="job-type">Contract</span>
                        </div> *@
                    </div>
                </div>

                <!-- Action Buttons -->
                @* <div class="action-buttons">
                    <a asp-action="UpdateProfile" asp-controller="Company" asp-route-id="@Model.Id" class="btn-primary" onclick="editProfile()">
                        <i class="fas fa-edit"></i> Edit Company
                    </a>
                <a asp-action="ApplicationsForMyJobs" asp-controller="Application" class="btn-secondary" onclick="viewApplications()">
                        <i class="fas fa-users"></i> View Applications
                    </a>
                </div> *@
            <!-- Action Buttons -->
            @if (User.IsInRole("Company") && loggedInUserId == Model.Id)
            {
                <div class="action-buttons">
                    <a asp-controller="Company" asp-action="UpdateProfile" asp-route-id="@Model.Id" class="btn-profile-primary">
                        <i class="fas fa-edit" style="text-align:center"></i>Edit Profile
                    </a>
                    <a asp-controller="Application" asp-action="ApplicationsForMyJobs" class="btn-profile-secondary">
                        <i class="fas fa-list" style="text-align:center"></i> My Applications
                    </a>
                </div>
            }
            else if (User.IsInRole("Admin"))
            {
                @* <partial name="_ButtonProfileApprove" model="Model" /> *@
                <div class="profile-action-buttons">
                    @* <a asp-controller="JobSeeker" asp-action="UpdateProfile" asp-route-jobseekerid="@Model.Id"  class="btn-profile-primary">
                <i class="fas fa-edit"></i> Edit Profile
            </a> *@
                    <a asp-controller="Application" asp-action="ApplicationsForMyJobs" class="btn-profile-secondary">
                        <i class="fas fa-list"></i> My Applications
                    </a>
                </div>
            }
    
            </div>
        </div>
    </div>

