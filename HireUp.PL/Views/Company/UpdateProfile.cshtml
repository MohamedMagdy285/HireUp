@model CompanyViewModel

@inject ICategoryRepository _categoryRepository;

@{
    Layout = "_Layout";
    var Categories = _categoryRepository.GetAll();
    SelectList CategoryList = new SelectList(Categories, "Id", "Name");

}

@section Styles
{
    <link href="~/css/Company/UpdateProfile.css" rel="stylesheet">

}


    <div class="form-container">
        <div class="form-header">
            <div class="avatar-icon">🏢</div>
            <h1>Company Profile</h1>
            <p>Complete your company information</p>
        </div>

        <form asp-action="UpdateProfile" asp-controller="Company">
            <input type="hidden" asp-for="Id" />
            <!-- Basic Information Section -->
            <div class="form-section">
                <div class="section-title">
                    <label>Basic Information</label>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Company Name <span class="required">*</span></label>
                        <input type="text" placeholder="Enter company name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label asp-for="Industry" >Industry <span class="required">*</span></label>
                       
                    <select class="form-control" asp-for="CategoryId" asp-items="CategoryList" required>
                        <option value="" disabled selected>Select Category</option>
                    </select>
                    </div>
                </div>

                <div class="form-row full">
                    <div class="form-group">
                        <label asp-for="Email" >Email <span class="required">*</span></label>
                        <input asp-for="Email"  placeholder="Enter your email" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="PhoneNumber" >Phone Number</label>
                        <input asp-for="PhoneNumber" placeholder="Enter your phone number" >
                    </div>
                    <div class="form-group">
                        <label asp-for="Country" >Country <span class="required">*</span></label>
                        <select asp-for="Country" name="country" required>
                            <option value="">Select a country</option>
                            <option value="United Arab Emirates">United Arab Emirates</option>
                            <option value="Saudi Arabia">Saudi Arabia</option>
                            <option value="Egypt">Egypt</option>
                            <option value="Kuwait">Kuwait</option>
                            <option value="Qatar">Qatar</option>
                            <option value="Bahrain">Bahrain</option>
                            <option value="Oman">Oman</option>
                            <option value="Jordan">Jordan</option>
                            <option value="Lebanon">Lebanon</option>
                            <option value="United States">United States</option>
                            <option value="United Kingdom">United Kingdom</option>
                            <option value="Canada">Canada</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="form-row full">
                    <div class="form-group">
                        <label asp-for="Location" >Location <span class="required">*</span></label>
                        <input asp-for="Location" placeholder="Enter city or office location"  required>
                    </div>
                </div>
            </div>

            <hr class="divider">

            <!-- Professional Information Section -->
            <div class="form-section">
                <div class="section-title">
                    <label>Professional Information</label>
                </div>

                <div class="form-row full">
                    <div class="form-group">
                        <label asp-for="Description" >Company Description</label>
                        <textarea asp-for="Description" placeholder="Describe your company..."></textarea>
                    </div>
                </div>

            @*     <div class="form-row full">
                    <div class="form-group">
                        <label>Website URL</label>
                        <input type="url" placeholder="https://www.example.com" name="websiteURL">
                    </div>
                </div>
            </div> *@

            <hr class="divider">

            <!-- Logo Upload Section -->
            <div class="form-section">
                <div class="section-title">
                    <label>Company Logo</label>
                </div>

                <div class="upload-area" onclick="document.getElementById('logoUpload').click()">
                    <div class="upload-icon">📤</div>
                    <p class="upload-text">
                        <strong>Click to upload</strong> or drag and drop<br>
                        PNG, JPG, GIF (max. 5MB)
                    </p>
                </div>
                <input type="file" id="logoUpload" name="logoURL" accept="image/*">
                <small style="color: #9ca3af; display: block; margin-top: 8px;">
                    <span id="fileName">No file selected</span>
                </small>
            </div>

            <hr class="divider">

            <!-- Form Actions -->
            <div class="form-actions">

                
                        
                        <button type="submit" class="btn-save">
                            ✓ Save Changes
                  </button> 
                            
            </div>
        </form>
    </div>

